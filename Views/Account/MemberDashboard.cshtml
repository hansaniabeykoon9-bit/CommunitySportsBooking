@{
    ViewData["Title"] = "Member Dashboard";

    string memberName =
        ViewBag.MemberName ?? "Member";

    int upcomingBookings =
        ViewBag.UpcomingBookings ?? 0;

    int totalBookings =
        ViewBag.TotalBookings ?? 0;

    int totalReviews =
        ViewBag.TotalReviews ?? 0;

    decimal amountSpent =
        ViewBag.AmountSpent ?? 0m;

    var upcomingBookingList =
        ViewBag.UpcomingBookingList
        as List<CommunitySportsBooking.Models.Booking>
        ?? new List<CommunitySportsBooking.Models.Booking>();
}


<div class="container py-5">


    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-4">
            @TempData["SuccessMessage"]
        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger mb-4">
            @ViewBag.ErrorMessage
        </div>
    }


    <!-- DASHBOARD HEADER -->

    <div class="dashboard-header mb-5">

        <div>

            <span class="text-success fw-bold">
                MEMBER AREA
            </span>

            <h1 class="fw-bold mt-2 mb-2">
                Welcome, @memberName 👋
            </h1>

            <p class="text-muted mb-0">
                Manage your bookings, reviews and facility activities.
            </p>

        </div>


        <div>

            <a asp-controller="Facility"
               asp-action="Search"
               class="btn btn-success">

                Find a Facility

            </a>

        </div>

    </div>


    <!-- STATISTICS -->

    <div class="row g-4 mb-5">


        <!-- UPCOMING BOOKINGS -->

        <div class="col-md-6 col-xl-3">

            <div class="dashboard-stat-card">

                <div class="dashboard-stat-icon">
                    📅
                </div>

                <div>

                    <span class="dashboard-stat-label">
                        Upcoming Bookings
                    </span>

                    <h2 class="dashboard-stat-number">
                        @upcomingBookings
                    </h2>

                </div>

            </div>

        </div>


        <!-- TOTAL BOOKINGS -->

        <div class="col-md-6 col-xl-3">

            <div class="dashboard-stat-card">

                <div class="dashboard-stat-icon">
                    🏟️
                </div>

                <div>

                    <span class="dashboard-stat-label">
                        Total Bookings
                    </span>

                    <h2 class="dashboard-stat-number">
                        @totalBookings
                    </h2>

                </div>

            </div>

        </div>


        <!-- REVIEWS -->

        <div class="col-md-6 col-xl-3">

            <div class="dashboard-stat-card">

                <div class="dashboard-stat-icon">
                    ⭐
                </div>

                <div>

                    <span class="dashboard-stat-label">
                        Reviews Submitted
                    </span>

                    <h2 class="dashboard-stat-number">
                        @totalReviews
                    </h2>

                </div>

            </div>

        </div>


        <!-- AMOUNT SPENT -->

        <div class="col-md-6 col-xl-3">

            <div class="dashboard-stat-card">

                <div class="dashboard-stat-icon">
                    💰
                </div>

                <div>

                    <span class="dashboard-stat-label">
                        Amount Spent
                    </span>

                    <h2 class="dashboard-stat-number">
                        Rs. @amountSpent.ToString("N2")
                    </h2>

                </div>

            </div>

        </div>

    </div>


    <!-- QUICK ACTIONS -->

    <h2 class="fw-bold mb-4">
        Quick Actions
    </h2>


    <div class="row g-4 mb-5">


        <!-- FIND FACILITY -->

        <div class="col-md-4">

            <div class="dashboard-action-card h-100">

                <div class="dashboard-action-icon">
                    🔎
                </div>

                <h4>
                    Find a Facility
                </h4>

                <p class="text-muted">
                    Search sports facilities by type,
                    location and availability.
                </p>

                <a asp-controller="Facility"
                   asp-action="Search"
                   class="btn btn-success">

                    Search Facilities

                </a>

            </div>

        </div>


        <!-- MY BOOKINGS -->

        <div class="col-md-4">

            <div class="dashboard-action-card h-100">

                <div class="dashboard-action-icon">
                    📋
                </div>

                <h4>
                    My Bookings
                </h4>

                <p class="text-muted">
                    View your current and previous
                    facility bookings.
                </p>

                <a asp-controller="Booking"
                   asp-action="MyBookings"
                   class="btn btn-success">

                    View Bookings

                </a>

            </div>

        </div>


        <!-- MY REVIEWS -->

        <div class="col-md-4">

            <div class="dashboard-action-card h-100">

                <div class="dashboard-action-icon">
                    ⭐
                </div>

                <h4>
                    My Reviews
                </h4>

                <p class="text-muted">
                    View reviews you have submitted
                    for community facilities.
                </p>

                <a asp-controller="Review"
                   asp-action="MyReviews"
                   class="btn btn-success">

                    View Reviews

                </a>

            </div>

        </div>

    </div>


    <!-- UPCOMING BOOKINGS -->

    <div class="dashboard-panel mb-5">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h3 class="fw-bold mb-1">
                    Upcoming Bookings
                </h3>

                <p class="text-muted mb-0">
                    Your next scheduled facility bookings.
                </p>

            </div>

            <a asp-controller="Booking"
               asp-action="MyBookings"
               class="text-success fw-semibold">

                View All

            </a>

        </div>


        @if (upcomingBookingList.Count > 0)
        {
            <div class="row g-3">

                @foreach (var booking in upcomingBookingList)
                {
                    <div class="col-12">

                        <div class="upcoming-booking-card">


                            <!-- FACILITY -->

                            <div class="upcoming-booking-main">

                                <div class="upcoming-booking-icon">
                                    🏟️
                                </div>

                                <div>

                                    <h4 class="mb-1">
                                        @booking.FacilityName
                                    </h4>

                                    <span class="text-muted">
                                        Booking #@booking.BookingID
                                    </span>

                                </div>

                            </div>


                            <!-- DATE -->

                            <div class="upcoming-booking-info">

                                <span class="booking-info-label">
                                    Date
                                </span>

                                <strong>
                                    @booking.BookingDate.ToString("dd MMM yyyy")
                                </strong>

                            </div>


                            <!-- TIME -->

                            <div class="upcoming-booking-info">

                                <span class="booking-info-label">
                                    Time
                                </span>

                                <strong>
                                    @DateTime.Today.Add(booking.StartTime).ToString("hh:mm tt")
                                    -
                                    @DateTime.Today.Add(booking.EndTime).ToString("hh:mm tt")
                                </strong>

                            </div>


                            <!-- STATUS -->

                            <div>

                                @if (booking.BookingStatus == "Confirmed")
                                {
                                    <span class="booking-status confirmed">
                                        Confirmed
                                    </span>
                                }
                                else
                                {
                                    <span class="booking-status pending">
                                        Pending
                                    </span>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="dashboard-empty-state">

                <div class="dashboard-empty-icon">
                    📅
                </div>

                <h4>
                    No upcoming bookings
                </h4>

                <p class="text-muted mb-3">
                    You don't have any upcoming facility bookings.
                </p>

                <a asp-controller="Facility"
                   asp-action="Search"
                   class="btn btn-success">

                    Book a Facility

                </a>

            </div>
        }

    </div>


    <!-- MEMBERSHIP BENEFITS -->

    <div class="dashboard-benefits">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <h3 class="fw-bold">
                    Make the most of your membership
                </h3>

                <p class="text-muted mb-0">
                    Book community sports facilities,
                    keep track of your activities and
                    share your experience through reviews.
                </p>

            </div>

            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">

                <a asp-controller="Review"
                   asp-action="Create"
                   class="btn btn-success">

                    Submit a Review

                </a>

            </div>

        </div>

    </div>

</div>