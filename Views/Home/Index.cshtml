@{
    ViewData["Title"] = "Home";
}

<!-- =========================================================
     HERO SECTION
     ========================================================= -->

<section class="home-hero">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-7">

                <div class="hero-content">

                    <div class="hero-eyebrow">
                        COMMUNITY SPORTS COUNCIL
                    </div>

                    <h1 class="hero-title">
                        Stay Active.<br />
                        Play More.<br />
                        Book Easily.
                    </h1>

                    <p class="hero-text">
                        Discover local sports facilities, find your
                        favourite activity and make your next game
                        easier to plan.
                    </p>

                    <div class="hero-actions">

                        <a asp-controller="Facility"
                           asp-action="Search"
                           class="btn btn-success">
                            Explore Facilities
                        </a>

                        <a asp-controller="Account"
                           asp-action="Register"
                           class="btn btn-outline-success">
                            Become a Member
                        </a>

                    </div>

                </div>

            </div>


            <div class="col-lg-5">

                <div class="hero-card">

                    <div class="hero-card-icon">
                        ⚽
                    </div>

                    <h3>
                        Community Sports
                    </h3>

                    <p>
                        Tennis, football, basketball, badminton
                        and more — all in one place.
                    </p>

                    <div class="mt-4">

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="fw-semibold">

                            Member Sign In →

                        </a>

                        <br />

                        <a asp-controller="Account"
                           asp-action="Register"
                           class="fw-semibold">

                            New Member Registration →

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     SPORTS SECTION
     ========================================================= -->

<section class="home-section">

    <div class="container">

        <div class="section-eyebrow">
            WHAT WE OFFER
        </div>

        <h2 class="section-title">
            Sports for Everyone
        </h2>

        <p class="section-subtitle mb-5">
            Find a facility that suits your favourite activity
            and get moving.
        </p>


        <div class="sports-grid">


            <!-- TENNIS -->

            <div class="sport-card">

                <div class="sport-icon">
                    🎾
                </div>

                <h3>
                    Tennis
                </h3>

                <p>
                    Courts suitable for recreational and
                    community tennis.
                </p>

            </div>


            <!-- FOOTBALL -->

            <div class="sport-card">

                <div class="sport-icon">
                    ⚽
                </div>

                <h3>
                    Football
                </h3>

                <p>
                    Community football fields for teams,
                    training and recreation.
                </p>

            </div>


            <!-- BASKETBALL -->

            <div class="sport-card">

                <div class="sport-icon">
                    🏀
                </div>

                <h3>
                    Basketball
                </h3>

                <p>
                    Accessible basketball courts for
                    individuals and groups.
                </p>

            </div>


            <!-- BADMINTON -->

            <div class="sport-card">

                <div class="sport-icon">
                    🏸
                </div>

                <h3>
                    Badminton
                </h3>

                <p>
                    Indoor facilities for badminton and
                    community activities.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     HOW IT WORKS
     ========================================================= -->

<section class="home-section">

    <div class="container">

        <div class="section-eyebrow">
            HOW IT WORKS
        </div>

        <h2 class="section-title">
            Book in Three Simple Steps
        </h2>


        <div class="steps-grid mt-5">


            <!-- STEP 1 -->

            <div class="step-card">

                <div class="step-number">
                    01
                </div>

                <h3>
                    Find a Facility
                </h3>

                <p>
                    Search sports facilities by type,
                    location, date and availability.
                </p>

            </div>


            <!-- STEP 2 -->

            <div class="step-card">

                <div class="step-number">
                    02
                </div>

                <h3>
                    Make a Booking
                </h3>

                <p>
                    Select an available facility and choose
                    your preferred time slot.
                </p>

            </div>


            <!-- STEP 3 -->

            <div class="step-card">

                <div class="step-number">
                    03
                </div>

                <h3>
                    Enjoy Your Game
                </h3>

                <p>
                    Complete your booking and enjoy your
                    community sports activity.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     MEMBERSHIP CTA
     ========================================================= -->

<section class="home-membership-section">

    <div class="container">

        <div class="home-membership-cta">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <div class="eyebrow">
                        FOR COMMUNITY MEMBERS
                    </div>

                    <h2>
                        Ready to get active?
                    </h2>

                    <p class="mb-0">
                        Create your account to search facilities,
                        make bookings and share your experience.
                    </p>

                </div>


                <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-success me-2">

                        Sign In

                    </a>

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="btn btn-outline-success">

                        Register

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     GUEST SERVICES
     ========================================================= -->

<section class="home-guest-section">

    <div class="container">

        <div class="eyebrow">
            GUEST SERVICES
        </div>

        <h2>
            Explore Before You Join
        </h2>

        <p class="mb-5">
            Guests can explore facilities, read community
            reviews, become members and contact the Sports Council.
        </p>


        <!-- GUEST SERVICE CARDS -->

        <div class="row g-4">


            <!-- BROWSE FACILITIES -->

            <div class="col-md-6 col-lg-3">

                <div class="guest-service-card">

                    <div class="guest-service-icon">
                        🏟️
                    </div>

                    <h3>
                        Browse Facilities
                    </h3>

                    <p>
                        View facility types, locations and
                        general availability.
                    </p>

                    <a asp-controller="Facility"
                       asp-action="GuestSearch">

                        Browse Facilities →

                    </a>

                </div>

            </div>


            <!-- READ REVIEWS -->

            <div class="col-md-6 col-lg-3">

                <div class="guest-service-card">

                    <div class="guest-service-icon">
                        ⭐
                    </div>

                    <h3>
                        Read Reviews
                    </h3>

                    <p>
                        See experiences and ratings shared by
                        registered community members.
                    </p>

                    <a asp-controller="Review"
                       asp-action="Search">

                        View Reviews →

                    </a>

                </div>

            </div>


            <!-- BECOME A MEMBER -->

            <div class="col-md-6 col-lg-3">

                <div class="guest-service-card">

                    <div class="guest-service-icon">
                        👤
                    </div>

                    <h3>
                        Become a Member
                    </h3>

                    <p>
                        Register as a community member to access
                        facility booking and other member services.
                    </p>

                    <a asp-controller="Account"
                       asp-action="Register">

                        Become a Member →

                    </a>

                </div>

            </div>


            <!-- CONTACT US -->

            <div class="col-md-6 col-lg-3">

                <div class="guest-service-card">

                    <div class="guest-service-icon">
                        💬
                    </div>

                    <h3>
                        Contact Us
                    </h3>

                    <p>
                        Have a question about facilities,
                        programmes or membership?
                    </p>

                    <a asp-controller="Inquiry"
                       asp-action="Create">

                        Send an Inquiry →

                    </a>

                </div>

            </div>


        </div>

    </div>

</section>