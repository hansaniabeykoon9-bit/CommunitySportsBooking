@model List<CommunitySportsBooking.Models.Review>

@{
    ViewData["Title"] = "Read Reviews";
}

<div class="page-container">

    <!-- PAGE HEADER -->
    <div class="page-header">

        <div>
            <span class="page-eyebrow">
                COMMUNITY FEEDBACK
            </span>

            <h1>Read Reviews</h1>

            <p>
                See experiences and ratings shared by registered
                community members.
            </p>
        </div>

    </div>


    <!-- SEARCH PANEL -->
    <div class="review-search-panel">

        <h3>Find Reviews</h3>

        <p class="search-description">
            Search reviews by facility name or rating.
        </p>

        <form asp-controller="Review"
              asp-action="Search"
              method="get">

            <div class="row g-3">

                <!-- FACILITY -->
                <div class="col-md-6">

                    <label class="form-label">
                        Facility Name
                    </label>

                    <input type="text"
                           name="facilityName"
                           value="@ViewBag.FacilityName"
                           class="form-control"
                           placeholder="e.g. Kandy Tennis Court" />

                </div>


                <!-- RATING -->
                <div class="col-md-4">

                    <label class="form-label">
                        Rating
                    </label>

                    <select name="rating"
                            class="form-select">

                        <option value="">
                            All Ratings
                        </option>

                        @for (int i = 5; i >= 1; i--)
                        {
                            if (ViewBag.Rating != null &&
                            Convert.ToInt32(ViewBag.Rating) == i)
                            {
                                <option value="@i" selected>
                                    @i Star@(i == 1 ? "" : "s")
                                </option>
                            }
                            else
                            {
                                <option value="@i">
                                    @i Star@(i == 1 ? "" : "s")
                                </option>
                            }
                        }

                    </select>

                </div>


                <!-- SEARCH BUTTON -->
                <div class="col-md-2 d-flex align-items-end">

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Search
                    </button>

                </div>

            </div>

        </form>

    </div>


    <!-- ERROR -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }


    <!-- RESULTS -->
    <div class="review-results-section">

        <div class="review-results-header">

            <div>

                <h2>Community Reviews</h2>

                <p>
                    @Model.Count
                    review@(Model.Count == 1 ? "" : "s") found.
                </p>

            </div>

        </div>


        @if (Model != null && Model.Count > 0)
        {
            <div class="reviews-grid">

                @foreach (var review in Model)
                {
                    <div class="review-card">

                        <!-- RATING -->
                        <div class="review-stars">

                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= review.Rating)
                                {
                                    <span>★</span>
                                }
                                else
                                {
                                    <span class="empty-star">
                                        ☆
                                    </span>
                                }
                            }

                        </div>


                        <!-- FACILITY -->
                        <h3 class="review-facility">
                            @review.FacilityName
                        </h3>


                        <!-- COMMENT -->
                        <p class="review-comment">
                            "@review.Comment"
                        </p>


                        <!-- FOOTER -->
                        <div class="review-footer">

                            <span>
                                Community Member
                            </span>

                            <span>
                                @review.ReviewDate.ToString("dd MMM yyyy")
                            </span>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="review-empty-state">

                <div class="review-empty-icon">
                    ⭐
                </div>

                <h3>No reviews found</h3>

                <p>
                    There are no reviews matching your search.
                    Try another facility or rating.
                </p>

                <a asp-controller="Review"
                   asp-action="Search"
                   class="btn btn-outline-primary">
                    View All Reviews
                </a>

            </div>
        }

    </div>


    <!-- BOTTOM BUTTONS -->
    <div class="review-bottom-actions">

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-primary">
            ← Back to Home
        </a>

        <a asp-controller="Facility"
           asp-action="GuestSearch"
           class="btn btn-primary">
            Browse Facilities →
        </a>

    </div>

</div>
